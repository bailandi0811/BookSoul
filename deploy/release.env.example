# Linux server: copy outside this repository; use absolute paths, no quotes/interpolation.
# These are release coordinates, NOT application credentials.
WEB_IMAGE=booksoul-web:release-001
API_IMAGE=booksoul-api:release-001
MIGRATION_IMAGE=booksoul-migration:release-001
APP_ENV_FILE=/etc/booksoul/app.env
UPLOAD_HOST_DIR=/srv/booksoul/books
TLS_HOST_DIR=/etc/booksoul/tls
