# Database
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/booksoul?schema=public

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Existing app config (fill as needed)
MILVUS_ADDRESS=
MILVUS_TOKEN=
MILVUS_REQUEST_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_MODEL_NAME=text-embedding-v3
MODEL_NAME=qwen-plus
OPENAI_REQUEST_TIMEOUT_MS=20000
AMAP_API_KEY=
# MCP 工具默认全部关闭。启用时填写精确工具名并用逗号分隔。
MCP_ALLOWED_TOOL_NAMES=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
