# Database
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/booksoul?schema=public

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private book uploads
BOOK_UPLOAD_DIR=uploads/books
BOOK_MAX_UPLOAD_BYTES=52428800
BOOK_PARSER_VERSION=book-parser-v1
BOOK_EMBEDDING_VERSION=book-embedding-v1
BOOK_MAX_EPUB_ENTRIES=5000
BOOK_MAX_EPUB_UNCOMPRESSED_BYTES=104857600
BOOK_MAX_SECTIONS=5000
BOOK_TXT_FALLBACK_SECTION_CHARS=20000
BOOK_CHUNK_SIZE=800
BOOK_CHUNK_OVERLAP=120
BOOK_INGESTION_POLL_MS=2000
BOOK_INGESTION_STALE_MS=900000
BOOK_INGESTION_WORKER_ENABLED=true
BOOK_EMBEDDING_BATCH_SIZE=32
BOOK_EMBEDDING_MAX_ATTEMPTS=3
BOOK_EMBEDDING_RETRY_BASE_MS=500
BOOK_DELETION_RETRY_MS=30000

# Model and vector services
MILVUS_ADDRESS=
MILVUS_TOKEN=
MILVUS_BOOK_COLLECTION_NAME=book_chunks_v2
MILVUS_REQUEST_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_MODEL_NAME=text-embedding-v3
MODEL_NAME=qwen-plus
OPENAI_REQUEST_TIMEOUT_MS=20000
