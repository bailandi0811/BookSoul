generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  authVersion     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  refreshTokens   RefreshToken[]
  authChallenges  AuthChallenge[]
  books           Book[]
  bookAssistants  BookAssistant[]
  readingProgress ReadingProgress[]
  readingPositions BookReadingPosition[]
  agentRuns       AgentRun[]
  avatarAssetId   String?
  avatarAsset     UserMediaAsset? @relation("CurrentAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  wallpaperMode   WallpaperMode @default(RANDOM)
  fixedWallpaperKind WallpaperKind?
  fixedWallpaperId String?
  profileRevision Int @default(0)
  mediaAssets     UserMediaAsset[] @relation("OwnedMedia")
  communityMemberships CommunityMember[]
}

enum WallpaperMode {
  RANDOM
  FIXED
}

enum WallpaperKind {
  SYSTEM
  USER
}

enum MediaPurpose {
  AVATAR
  WALLPAPER
}

enum MediaAssetStatus {
  PENDING
  READY
  RETIRED
  REJECTED
  DELETED
}

model UserMediaAsset {
  id String @id @default(uuid())
  ownerId String
  owner User @relation("OwnedMedia", fields: [ownerId], references: [id], onDelete: Restrict)
  avatarUsers User[] @relation("CurrentAvatar")
  purpose MediaPurpose
  status MediaAssetStatus @default(PENDING)
  uploadKey String @unique
  objectKey String @unique
  declaredMime String
  declaredBytes Int
  width Int?
  height Int?
  storedBytes Int?
  uploadExpiresAt DateTime
  commitExpiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  retiredAt DateTime?
  stagingCleanedAt DateTime?

  @@index([ownerId, purpose, status])
  @@index([ownerId, createdAt])
  @@index([status, commitExpiresAt])
}

enum AuthChallengePurpose {
  REGISTRATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuthChallengeDeliveryState {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

model AuthChallenge {
  id               String                     @id @default(uuid())
  verificationId   String                     @unique @default(uuid())
  email            String
  purpose          AuthChallengePurpose
  userId           String?
  user             User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation       Int                        @default(0)
  secretHash       String                     @unique
  expiresAt        DateTime
  attempts         Int                        @default(0)
  consumedAt       DateTime?
  deliveryState    AuthChallengeDeliveryState @default(PENDING)
  resendAllowedAt  DateTime
  windowStartedAt  DateTime
  sendCount        Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([email, purpose])
  @@index([expiresAt])
}

model RefreshToken {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String         @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  replacedBy   RefreshToken?  @relation("TokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken[] @relation("TokenReplacement")
  createdAt    DateTime       @default(now())
  userAgent    String?
  ip           String?

  @@index([userId])
}

model ChatSessionRecord {
  ownerId         String
  sessionId       String
  bookAssistantId String?
  bookAssistant   BookAssistant? @relation(fields: [bookAssistantId], references: [id], onDelete: Cascade)
  title           String?
  messages        Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@id([ownerId, sessionId])
  @@index([ownerId, updatedAt])
  @@index([bookAssistantId, updatedAt])
}

model UserProfileRecord {
  id          String   @id @default(uuid())
  ownerId     String
  sessionId   String
  preferences Json
  facts       Json
  summary     String
  createdAt   DateTime
  updatedAt   DateTime

  @@unique([ownerId, sessionId])
  @@index([ownerId])
}

model MemoryRecord {
  id         String   @id
  ownerId    String
  sessionId  String
  bookId     String?
  book       Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  level      String
  content    String
  importance Float
  category   String
  metadata   Json
  createdAt  DateTime
  updatedAt  DateTime

  @@index([ownerId, sessionId])
  @@index([ownerId, level])
  @@index([ownerId, bookId])
}

enum BookVisibility {
  PRIVATE
  SYSTEM
}

enum BookStatus {
  QUEUED
  PARSING
  CHUNKING
  EMBEDDING
  READY
  FAILED
  DELETING
}

enum AssistantResponseDepth {
  BRIEF
  BALANCED
  DEEP
}

enum AssistantTone {
  NATURAL
  WARM
  ANALYTICAL
}

enum ReadingMode {
  NOT_STARTED
  IN_PROGRESS
  FINISHED
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  CANCELLED
  FAILED
  LEASE_LOST
}

model Book {
  id               String            @id @default(uuid())
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility       BookVisibility    @default(PRIVATE)
  title            String
  author           String?
  originalFileName String
  storageKey       String
  mimeType         String
  fileSizeBytes    BigInt
  contentHash      String
  language         String?
  coverStorageKey  String?
  status           BookStatus        @default(QUEUED)
  statusProgress   Int               @default(0)
  failureCode      String?
  failureMessage   String?
  sectionCount     Int               @default(0)
  chunkCount       Int               @default(0)
  parserVersion    String
  embeddingVersion String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  readyAt          DateTime?
  sections         BookSection[]
  chunks           BookChunk[]
  assistants       BookAssistant[]
  readingProgress  ReadingProgress[]
  readingPositions BookReadingPosition[]
  ingestionJob     IngestionJob?
  memories         MemoryRecord[]
  agentRuns        AgentRun[]

  @@unique([ownerId, contentHash])
  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
}

model AgentRun {
  id             String         @id
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sessionId      String
  bookId         String?
  book           Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  status         AgentRunStatus @default(RUNNING)
  startedAt      DateTime       @default(now())
  heartbeatAt    DateTime       @default(now())
  leaseExpiresAt DateTime
  completedAt    DateTime?
  failureCode    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([ownerId, sessionId, status])
  @@index([status, leaseExpiresAt])
  @@index([bookId, startedAt])
}

model BookSection {
  id        String      @id @default(uuid())
  bookId    String
  book      Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  sourceRef String?
  content   String
  charCount Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  chunks    BookChunk[]
  readingPositions BookReadingPosition[]

  @@unique([bookId, order])
  @@index([bookId])
}

model BookChunk {
  id               String      @id @default(uuid())
  bookId           String
  book             Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sectionId        String
  section          BookSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionOrder     Int
  chunkIndex       Int
  content          String
  startOffset      Int?
  endOffset        Int?
  embeddingVersion String
  createdAt        DateTime    @default(now())

  @@unique([sectionId, chunkIndex, embeddingVersion])
  @@index([bookId, embeddingVersion])
  @@index([bookId, sectionOrder])
}

model BookAssistant {
  id                String                 @id @default(uuid())
  ownerId           String
  owner             User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookId            String
  book              Book                   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name              String
  responseDepth     AssistantResponseDepth @default(BALANCED)
  tone              AssistantTone          @default(NATURAL)
  customInstruction String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  chatSessions      ChatSessionRecord[]

  @@unique([ownerId, bookId])
  @@index([bookId])
}

model ReadingProgress {
  ownerId             String
  owner               User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookId              String
  book                Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mode                ReadingMode @default(NOT_STARTED)
  currentSectionOrder Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@id([ownerId, bookId])
  @@index([bookId])
}

model BookReadingPosition {
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sectionId   String
  section     BookSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  offset      Int
  contentHash String
  revision    Int         @default(1)
  updatedAt   DateTime    @updatedAt

  @@id([ownerId, bookId])
  @@index([bookId])
  @@index([sectionId])
}

model IngestionJob {
  id          String             @id @default(uuid())
  bookId      String             @unique
  book        Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status      IngestionJobStatus @default(QUEUED)
  attempt     Int                @default(0)
  lockedAt    DateTime?
  heartbeatAt DateTime?
  lastError   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, updatedAt])
}

model CommunityRoom {
  id String @id
  lastEventSeq BigInt @default(0)
  createdAt DateTime @default(now())
  members CommunityMember[]
  messages CommunityMessage[]
  events CommunityEvent[]
}

model CommunityMember {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  roomId String
  room CommunityRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  consentVersion String
  lastReadSeq BigInt @default(0)
  isModerator Boolean @default(false)
  mutedUntil DateTime?
  sendWindowStartedAt DateTime?
  sendCount Int @default(0)
  joinedAt DateTime @default(now())
  messages CommunityMessage[]

  @@unique([roomId, userId])
  reads CommunityMessageRead[]
}

enum CommunityRemovalKind {
  AUTHOR
  MODERATOR
}

model CommunityMessage {
  id String @id @default(uuid())
  roomId String
  room CommunityRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  authorMemberId String
  author CommunityMember @relation(fields: [authorMemberId], references: [id], onDelete: Restrict)
  authorName String
  clientMessageId String
  requestHash String
  content String?
  mentions Json @default("[]")
  replyToId String?
  replyTo CommunityMessage? @relation("CommunityReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies CommunityMessage[] @relation("CommunityReply")
  createdSeq BigInt
  createdAt DateTime @default(now())
  removedAt DateTime?
  removalKind CommunityRemovalKind?
  events CommunityEvent[]
  reads CommunityMessageRead[]

  @@unique([roomId, authorMemberId, clientMessageId])
  @@unique([roomId, createdSeq])
  @@index([roomId, replyToId])
}

model CommunityMessageRead {
  memberId String
  member CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  messageId String
  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())

  @@id([memberId, messageId])
  @@index([messageId])
}

enum CommunityEventKind {
  MESSAGE_CREATED
  MESSAGE_REMOVED
  MEMBER_MUTED
}

model CommunityEvent {
  roomId String
  room CommunityRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  seq BigInt
  kind CommunityEventKind
  messageId String?
  message CommunityMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  targetMemberId String?
  actorMemberId String
  reason String?
  clientActionId String?
  requestHash String?
  mutedUntil DateTime?
  createdAt DateTime @default(now())

  @@id([roomId, seq])
  @@unique([roomId, actorMemberId, clientActionId])
}
